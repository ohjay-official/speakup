{
 "name": "lane 1: Nebius gpt-oss-120b (paid with promo credit): validate on human-labelled replies, then grade pushback, main, extra arms",
 "kind": "chat",
 "max_tokens": 3000,
 "time_budget_min": 200,
 "stages": [
  {
   "pre": [
    [
     "scripts/build_grading.py",
     "data/grading/human40.jsonl",
     "--results",
     "results/pilot.jsonl",
     "--prompts",
     "data/prompts/pilot.jsonl",
     "--human-key",
     "label/key_b1.json"
    ],
    [
     "scripts/build_grading.py",
     "data/grading/nb_push.jsonl",
     "--results",
     "results/pushback_qwen.jsonl",
     "--prompts",
     "data/prompts/pushback_qwen.jsonl",
     "--skip-graded",
     "results/grades_pushback.jsonl",
     "results/grades_pushback_d2.jsonl",
     "results/grades_pushback_d2b.jsonl",
     "results/grades_pushback_d2c.jsonl",
     "results/grades_pushback_nb.jsonl"
    ],
    [
     "scripts/build_grading.py",
     "data/grading/nb_main.jsonl",
     "--results",
     "results/main_qwen.jsonl",
     "results/main_qwen_redo.jsonl",
     "results/main_flashlite.jsonl",
     "--prompts",
     "data/prompts/main.jsonl",
     "--skip-graded",
     "results/grades_main.jsonl",
     "results/grades_main_l1.jsonl",
     "results/grades_main_l3.jsonl",
     "results/grades_main_v2.jsonl",
     "results/grades_main_d2.jsonl",
     "results/grades_main_d2b.jsonl",
     "results/grades_main_d2c.jsonl",
     "results/grades_main_nb.jsonl"
    ],
    [
     "scripts/build_grading.py",
     "data/grading/nb_rest.jsonl",
     "--results",
     "results/rest.jsonl",
     "--prompts",
     "data/prompts/anchor.jsonl",
     "data/prompts/general.jsonl",
     "--skip-graded",
     "results/grades_rest.jsonl",
     "results/grades_rest_v2.jsonl",
     "results/grades_rest_d2.jsonl",
     "results/grades_rest_d2b.jsonl",
     "results/grades_rest_d2c.jsonl",
     "results/grades_rest_nb.jsonl"
    ]
   ],
   "targets": [
    {
     "provider": "nebius",
     "model": "openai/gpt-oss-120b",
     "min_gap": 0.4,
     "prompts": "data/grading/human40.jsonl",
     "output": "results/grades_panel_pilot.jsonl"
    },
    {
     "provider": "nebius",
     "model": "openai/gpt-oss-120b",
     "min_gap": 0.4,
     "prompts": "data/grading/nb_push.jsonl",
     "output": "results/grades_pushback_nb.jsonl"
    },
    {
     "provider": "nebius",
     "model": "openai/gpt-oss-120b",
     "min_gap": 0.4,
     "prompts": "data/grading/nb_main.jsonl",
     "output": "results/grades_main_nb.jsonl"
    },
    {
     "provider": "nebius",
     "model": "openai/gpt-oss-120b",
     "min_gap": 0.4,
     "prompts": "data/grading/nb_rest.jsonl",
     "output": "results/grades_rest_nb.jsonl"
    }
   ]
  }
 ]
}