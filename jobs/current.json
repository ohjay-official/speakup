{
 "name": "lane 1: Gemini 3.5 Flash Lite pushback (prompts built locally; runner lacks scipy), retry remaining empty Qwen replies on Nebius, grade with Nebius",
 "kind": "chat",
 "max_tokens": 3000,
 "time_budget_min": 240,
 "stages": [
  {
   "targets": [
    {
     "provider": "gemini",
     "model": "gemini-3.5-flash-lite",
     "min_gap": 4,
     "prompts": "data/prompts/pushback.jsonl",
     "output": "results/pushback.jsonl"
    }
   ]
  },
  {
   "targets": [
    {
     "provider": "nebius",
     "model": "Qwen/Qwen3.8-27B",
     "aliases": [
      "qwen/qwen3.8-27b",
      "qwen-3.8-27b"
     ],
     "max_tokens": 8000,
     "min_gap": 0.3,
     "prompts": "data/prompts/qwen_redo.jsonl",
     "output": "results/main_qwen_redo.jsonl",
     "skip_any": true,
     "skip_files": [
      "results/main_qwen.jsonl"
     ]
    }
   ]
  },
  {
   "pre": [
    [
     "scripts/build_grading.py",
     "data/grading/nb2_main.jsonl",
     "--results",
     "results/main_qwen.jsonl",
     "results/main_qwen_redo.jsonl",
     "results/main_flashlite.jsonl",
     "--prompts",
     "data/prompts/main.jsonl",
     "--skip-graded",
     "results/grades_main.jsonl",
     "results/grades_main_l1.jsonl",
     "results/grades_main_l3.jsonl",
     "results/grades_main_v2.jsonl",
     "results/grades_main_d2.jsonl",
     "results/grades_main_d2b.jsonl",
     "results/grades_main_d2c.jsonl",
     "results/grades_main_nb.jsonl"
    ],
    [
     "scripts/build_grading.py",
     "data/grading/nb2_push.jsonl",
     "--results",
     "results/pushback.jsonl",
     "results/pushback_qwen.jsonl",
     "--prompts",
     "data/prompts/pushback.jsonl",
     "data/prompts/pushback_qwen.jsonl",
     "--skip-graded",
     "results/grades_pushback.jsonl",
     "results/grades_pushback_d2.jsonl",
     "results/grades_pushback_d2b.jsonl",
     "results/grades_pushback_d2c.jsonl",
     "results/grades_pushback_nb.jsonl"
    ]
   ],
   "targets": [
    {
     "provider": "nebius",
     "model": "openai/gpt-oss-120b",
     "min_gap": 0.4,
     "prompts": "data/grading/nb2_main.jsonl",
     "output": "results/grades_main_nb.jsonl"
    },
    {
     "provider": "nebius",
     "model": "openai/gpt-oss-120b",
     "min_gap": 0.4,
     "prompts": "data/grading/nb2_push.jsonl",
     "output": "results/grades_pushback_nb.jsonl"
    }
   ]
  }
 ]
}